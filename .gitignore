# General
# Ignore temporary files, editor directories, OS files and common build artifacts.

# Executables (project-specific)
maze

# Compiled object files, libraries, and executables
*.o
*.obj
*.so
*.dylib
*.a
*.exe
*.out
*.bin

# Build directories
build/
bin/
obj/
cmake-build*/
CMakeFiles/
CMakeCache.txt

# Dependency files
*.d

# Static analysis / coverage
.coverage
coverage.xml
htmlcov/
.pytest_cache/

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
venv/
env/
.venv/
pip-wheel-metadata/
*.egg-info/
dist/
build/

# Logs and crash dumps
*.log
core
gmon.out
vgcore.*

# Environment and secret files
.env
.env.local
.env.*

# Editor/IDE
.vscode/
.idea/
.project
.settings/
*.sublime-workspace
*.sublime-project
.vscode/*

# macOS
.DS_Store
.AppleDouble
._*

# Windows
Thumbs.db
ehthumbs.db

# Swap / backup / temp files
*.swp

.#*
*.tmp

# Misc
.coverage
.mypy_cache/
.pytest_cache/
.cache/

# Ignore build artifacts created by tests or local runs
*.log
*.tmp

# Keep repository clean of editor specific and system files
.idea/
